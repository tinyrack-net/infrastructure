logging {
  level  = "info"
  format = "logfmt"
}

prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

discovery.kubernetes "nodes" {
  role = "node"
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "kubelet" {
  targets = discovery.kubernetes.nodes.targets

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "__address__"
    replacement   = "kubernetes.default.svc:443"
  }
  rule {
    target_label = "__scheme__"
    replacement  = "https"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "instance"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/$1/proxy/metrics"
  }
}

discovery.relabel "cadvisor" {
  targets = discovery.kubernetes.nodes.targets

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "__address__"
    replacement   = "kubernetes.default.svc:443"
  }
  rule {
    target_label = "__scheme__"
    replacement  = "https"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "instance"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/$1/proxy/metrics/cadvisor"
  }
}

discovery.relabel "annotated_pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
  rule {
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    regex         = "([^:]+)(?::\\d+)?;(\\d+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.cluster.receiver]
}

prometheus.scrape "kube_state_metrics" {
  targets = [{
    __address__ = "monitoring-kube-state-metrics.monitoring-system.svc:8080",
    job         = "kube-state-metrics",
  }]
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.cluster.receiver]
}

prometheus.scrape "kubelet" {
  targets = discovery.relabel.kubelet.output
  authorization {
    credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  }
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.kubelet_metrics.receiver]
}

prometheus.scrape "cadvisor" {
  targets = discovery.relabel.cadvisor.output
  authorization {
    credentials_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  }
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.cadvisor_metrics.receiver]
}

prometheus.scrape "annotated_pods" {
  targets         = discovery.relabel.annotated_pods.output
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.cluster.receiver]
}

prometheus.scrape "alloy" {
  targets = [{
    __address__ = "127.0.0.1:12345",
    job         = "alloy",
  }]
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.cluster.receiver]
}

prometheus.relabel "kubelet_metrics" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|scrape_.*|kubelet_node_name|kubelet_volume_stats_.*|kubelet_runtime_operations_errors_total|kubelet_running_(pods|containers)"
    action        = "keep"
  }
  forward_to = [prometheus.relabel.cluster.receiver]
}

prometheus.relabel "cadvisor_metrics" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|scrape_.*|container_(cpu_usage_seconds_total|memory_working_set_bytes|memory_rss|fs_usage_bytes|fs_limit_bytes|network_receive_bytes_total|network_transmit_bytes_total|network_receive_errors_total|network_transmit_errors_total|last_seen)"
    action        = "keep"
  }
  forward_to = [prometheus.relabel.cluster.receiver]
}

prometheus.relabel "cluster" {
  rule {
    target_label = "cluster"
    replacement  = sys.env("CLUSTER_NAME")
  }
  rule {
    action = "labeldrop"
    regex  = "uid|container_id|image_id"
  }
  forward_to = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  endpoint {
    url = "https://telemetry.winetree94.com/api/v1/write"
    basic_auth {
      username = sys.env("TELEMETRY_USERNAME")
      password = sys.env("TELEMETRY_PASSWORD")
    }
    queue_config {
      capacity             = 5000
      max_shards           = 2
      min_shards           = 1
      max_samples_per_send = 1000
    }
  }
  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "app"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.kubernetes.receiver]
}

loki.source.kubernetes_events "events" {
  job_name   = "kubernetes-events"
  forward_to = [loki.process.kubernetes.receiver]
}

loki.process "kubernetes" {
  stage.static_labels {
    values = {
      cluster = sys.env("CLUSTER_NAME"),
    }
  }
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "https://telemetry.winetree94.com/insert/loki/api/v1/push"
    basic_auth {
      username = sys.env("TELEMETRY_USERNAME")
      password = sys.env("TELEMETRY_PASSWORD")
    }
  }
}

otelcol.auth.basic "central" {
  username = sys.env("TELEMETRY_USERNAME")
  password = sys.env("TELEMETRY_PASSWORD")
}

otelcol.receiver.otlp "local" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.memory_limiter.traces.input]
  }
}

otelcol.processor.memory_limiter "traces" {
  check_interval = "1s"
  limit          = "448MiB"
  spike_limit    = "32MiB"
  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout         = "5s"
  send_batch_size = 512
  output {
    traces = [otelcol.exporter.otlphttp.central.input]
  }
}

otelcol.exporter.otlphttp "central" {
  client {
    endpoint = "https://telemetry.winetree94.com"
    auth     = otelcol.auth.basic.central.handler
  }
  traces_endpoint = "https://telemetry.winetree94.com/insert/opentelemetry/v1/traces"
}
